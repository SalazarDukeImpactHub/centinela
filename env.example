# Credenciales de Centinela.
# Copiá este archivo como .env y completá el valor:
#
#     cp env.example .env
#
# GROQ_API_KEY — transcripción de voz (Whisper Large V3 en Groq).
# Se obtiene gratis en https://console.groq.com/ -> API Keys -> Create API Key.
# Sin ella el agente saluda pero no puede escuchar: la consola lo indica y
# bloquea el inicio de la llamada.
GROQ_API_KEY=gsk_completar_aqui

# Opcionales (valores por defecto razonables):
# OLLAMA_URL=http://localhost:11434     # docker compose lo fija solo
# MODELO_RAZONAMIENTO=llama3.2:3b       # debe estar en la lista permitida
